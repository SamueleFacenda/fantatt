# why: one squad with three scored slots, the smallest graph that exercises
# matchday, month, and season aggregation (docs/05-scoring-spec.md §11).
@prefix tt: <https://fantatt.org/ontology/tt#> .
@prefix r:  <https://fantatt.org/rules/settle/1.0.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://fantatt.org/data/squad/7f2a> a tt:Squad ;
  tt:month "2026-11"^^xsd:gYearMonth ;
  tt:hasSlot <https://fantatt.org/data/slot/a> , <https://fantatt.org/data/slot/b> ,
              <https://fantatt.org/data/slot/c> .
<https://fantatt.org/data/slot/a> r:slotScore 10 .
<https://fantatt.org/data/slot/b> r:slotScore 8 .
<https://fantatt.org/data/slot/c> r:slotScore 6 .
