# why: the certificate the engine emits at G1.10 replaces this contract; until
# then the verdict and the rules that must appear in it are the expectation.
verdict: checked
rules-fired:
  - settle.standings.matchdayScore (read: squad data:squad/7f2a slots scoring 10, 8, 6)
